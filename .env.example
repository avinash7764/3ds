DATABASE_URL="./data/app.db"

# --- Google sign-in / sign-up ---------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
#  -> "OAuth client ID" -> type "Web application".
#
# This app supports BOTH Google flows, so configure the pair that matches your deploy:
#   1) "Sign in with Google" button (Google Identity Services) — needs only the client ID
#      and your site listed under *Authorized JavaScript origins*. The ID token is verified
#      server-side against Google's tokeninfo endpoint. Used by /login.
#   2) Authorization-code popup flow — also needs GOOGLE_CLIENT_SECRET and your
#      <APP_URL>/auth/callback under *Authorized redirect URIs*. Used by /signup.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Absolute origin used to build OAuth redirect URIs and share/verification links.
# Falls back to NEXT_PUBLIC_SITE_URL, then http://localhost:3000.
# Examples:
#   APP_URL="https://3000-<sandboxId>.e2b.app"     (live preview of this repo)
#   APP_URL="http://localhost:3000"                (plain local dev)
#   APP_URL="https://ais-dev-....asia-southeast1.run.app"   (Cloud Run / AI Studio deploy)
APP_URL=""

# Secret used to sign the session cookie. Replace in production (>= 32 chars).
SESSION_SECRET="dev-only-secret-please-change-me-0123456789"

# Comma separated list — any of these Gmail accounts is auto-promoted to ADMIN on sign-in.
ADMIN_EMAILS="admin@3dsacademy.dev"

# When no GOOGLE_CLIENT_ID is configured (or you just want a quick local demo) a
# "Continue with demo account" option is shown. Set to "false" to disable it entirely.
ALLOW_DEMO_LOGIN="true"

NEXT_PUBLIC_SITE_NAME="3DS Academy"
# Kept for the browser bundle; server code prefers APP_URL (read at request time, so
# changing it needs no rebuild).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
