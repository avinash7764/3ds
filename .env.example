DATABASE_URL="./data/app.db"

# --- Google OAuth (Sign in with Google) -------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# -> "OAuth client ID" -> Web application, then add the *preview / production* origin to
#    "Authorized JavaScript origins". The ID token is verified server-side.
GOOGLE_CLIENT_ID=""

# Secret used to sign the session cookie. Replace in production (>= 32 chars).
SESSION_SECRET="dev-only-secret-please-change-me-0123456789"

# Comma separated list — any of these Gmail accounts is auto-promoted to ADMIN on sign-in.
ADMIN_EMAILS="admin@3dsacademy.dev"

# When no GOOGLE_CLIENT_ID is configured (or you just want a quick local demo) a
# "Continue with demo account" option is shown. Set to "false" to disable it entirely.
ALLOW_DEMO_LOGIN="true"

NEXT_PUBLIC_SITE_NAME="3DS Academy"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
